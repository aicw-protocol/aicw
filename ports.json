{
  "version": 1,
  "description": "Canonical local dev ports for the AICW ecosystem. Keep in sync with aicw_ecosystem.md.",
  "services": {
    "predict_dashboard": {
      "port": 3999,
      "repo": "predict",
      "url": "http://localhost:3999"
    },
    "aicw_home": {
      "port": 4001,
      "repo": "aicw_home",
      "url": "http://localhost:4001"
    },
    "aicw_app": {
      "port": 4002,
      "repo": "aicw_app",
      "url": "http://localhost:4002"
    },
    "aicw_node_web": {
      "port": 4003,
      "repo": "aicw_node_web",
      "url": "http://localhost:4003"
    },
    "makepoll": {
      "port": 4004,
      "repo": "makepoll",
      "url": "http://localhost:4004"
